{
  "builds": [
    {
      "src": "api/index_lite.py", 
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index_lite.py"
    }
  ],
  "env": {
    "PYTHONPATH": "app"
  },
  "functions": {
    "api/index_lite.py": {
      "maxDuration": 30
    }
  }
}
